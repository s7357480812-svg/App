  tab: { paddingHorizontal: Spacing.md, paddingVertical: Spacing.sm, borderRadius: Radius.pill, backgroundColor: Colors.surfaceSecondary, borderWidth: 1, borderColor: Colors.border },
  tabActive: { backgroundColor: Colors.brand, borderColor: Colors.brand },
  tabText: { color: Colors.onSurfaceSecondary, fontWeight: '700', fontSize: 11, letterSpacing: 1 },
  tabTextActive: { color: Colors.surface },
  content: { padding: Spacing.lg, gap: Spacing.md, paddingBottom: Spacing.xxxl },
  sectionLabel: { color: Colors.onSurfaceSecondary, fontSize: 11, letterSpacing: 2, fontWeight: '700', marginTop: Spacing.sm },
  pkgGrid: { flexDirection: 'row', flexWrap: 'wrap', gap: Spacing.sm },
  pkg: { flexGrow: 1, minWidth: '30%', backgroundColor: Colors.surfaceSecondary, borderRadius: Radius.md, padding: Spacing.md, borderWidth: 1, borderColor: Colors.border, alignItems: 'center' },
  pkgActive: { borderColor: Colors.brand, backgroundColor: Colors.brandTertiary },
  pkgCoins: { color: Colors.onSurface, fontSize: 24, fontWeight: '900' },
  pkgSub: { color: Colors.onSurfaceSecondary, fontSize: 10, letterSpacing: 1 },
  pkgPrice: { color: Colors.brand, fontSize: 14, fontWeight: '800', marginTop: 4 },
  qrCard: { backgroundColor: Colors.surfaceSecondary, borderRadius: Radius.lg, padding: Spacing.md, borderWidth: 1, borderColor: Colors.border, gap: Spacing.sm },
  qrBox: { backgroundColor: Colors.surface, borderRadius: Radius.md, padding: Spacing.lg, alignItems: 'center', borderWidth: 1, borderColor: Colors.border },
  qrHint: { color: Colors.onSurfaceSecondary, fontSize: 11, marginTop: Spacing.sm, textAlign: 'center' },
  upiRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', backgroundColor: Colors.surface, borderRadius: Radius.md, padding: Spacing.md, borderWidth: 1, borderColor: Colors.border },
  upiValue: { color: Colors.onSurface, fontWeight: '700' },
  uploadBox: { backgroundColor: Colors.surface, borderRadius: Radius.md, borderWidth: 1, borderColor: Colors.border, borderStyle: 'dashed', minHeight: 140, alignItems: 'center', justifyContent: 'center', overflow: 'hidden' },
  uploadImg: { width: '100%', height: 200, resizeMode: 'contain' },
  uploadText: { color: Colors.onSurfaceSecondary, marginTop: Spacing.sm },
  input: { backgroundColor: Colors.surface, borderRadius: Radius.md, padding: Spacing.md, color: Colors.onSurface, borderWidth: 1, borderColor: Colors.border },
  primaryBtn: { backgroundColor: Colors.brand, borderRadius: Radius.md, padding: Spacing.md, alignItems: 'center', marginTop: Spacing.sm },
  primaryBtnText: { color: Colors.surface, fontWeight: '800', letterSpacing: 1, fontSize: 14 },
  wdCard: { gap: Spacing.md, backgroundColor: Colors.surfaceSecondary, borderRadius: Radius.lg, padding: Spacing.md, borderWidth: 1, borderColor: Colors.border },
  helperText: { color: Colors.onSurfaceSecondary, fontSize: 12 },
  txnRow: { flexDirection: 'row', alignItems: 'center', padding: Spacing.md, backgroundColor: Colors.surfaceSecondary, borderRadius: Radius.md, borderWidth: 1, borderColor: Colors.border, gap: Spacing.md, marginBottom: Spacing.sm },
  txnTitle: { color: Colors.onSurface, fontWeight: '700' },
