import { useEffect, useState, useCallback } from 'react';
import {
  View, Text, StyleSheet, ScrollView, Pressable, TextInput, ActivityIndicator, RefreshControl, Alert, Image, Modal
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { MaterialCommunityIcons } from '@expo/vector-icons';
import * as ImagePicker from 'expo-image-picker';
import * as Clipboard from 'expo-clipboard';
import { Colors, Spacing, Radius } from '@/src/theme';
import { apiFetch } from '@/src/api';
import { useAuth } from '@/src/auth';

type Package = { id: string; coins: number; price: number };

export default function Wallet() {
  const { user, refresh } = useAuth();
  const [tab, setTab] = useState<'add' | 'withdraw' | 'history'>('add');
  const [packages, setPackages] = useState<Package[]>([]);
  const [upi, setUpi] = useState('');
  const [cfg, setCfg] = useState<any>(null);
  const [selectedPkg, setSelectedPkg] = useState<Package | null>(null);
  const [screenshot, setScreenshot] = useState<string | null>(null);
  const [utr, setUtr] = useState('');
  const [loading, setLoading] = useState(false);
  const [purchases, setPurchases] = useState<any[]>([]);
  const [txns, setTxns] = useState<any[]>([]);
  const [wds, setWds] = useState<any[]>([]);
  const [withdrawAmount, setWithdrawAmount] = useState('');
  const [refreshing, setRefreshing] = useState(false);
  const [showQr, setShowQr] = useState(false);

  const load = useCallback(async () => {
    try {
      const c = await apiFetch('/config');
      setCfg(c);
      setPackages(c.packages);
      setPurchases(await apiFetch('/my/purchases'));
      setTxns(await apiFetch('/my/transactions'));
      setWds(await apiFetch('/my/withdrawals'));
    } catch {}
  }, []);

  useEffect(() => { load(); }, [load]);

  const onRefresh = async () => { setRefreshing(true); await Promise.all([load(), refresh()]); setRefreshing(false); };

  const pickScreenshot = async () => {
    const perm = await ImagePicker.requestMediaLibraryPermissionsAsync();
    if (!perm.granted) { Alert.alert('Permission needed', 'Please allow gallery access'); return; }
    const result = await ImagePicker.launchImageLibraryAsync({
      mediaTypes: ImagePicker.MediaTypeOptions.Images,
      base64: true,
      quality: 0.6,
    });
    if (!result.canceled && result.assets[0]?.base64) {
      const b64 = result.assets[0].base64;
      const mime = result.assets[0].mimeType || 'image/jpeg';
      setScreenshot(`data:${mime};base64,${b64}`);
    }
  };

  const submitPurchase = async () => {
    if (!selectedPkg || !screenshot) { Alert.alert('Missing', 'Select package and upload screenshot'); return; }
    try {
      setLoading(true);
      await apiFetch('/purchase', {
        method: 'POST',
        body: JSON.stringify({ package_id: selectedPkg.id, screenshot_base64: screenshot, utr: utr || null }),
      });
      Alert.alert('Submitted', 'Payment submitted for admin verification');
      setSelectedPkg(null); setScreenshot(null); setUtr(''); setShowQr(false);
      await load();
    } catch (e: any) {
      Alert.alert('Error', e.message);
    } finally { setLoading(false); }
  };

  const submitWithdraw = async () => {
    const amt = parseInt(withdrawAmount, 10);
    if (!amt || amt <= 0) { Alert.alert('Invalid', 'Enter amount'); return; }
    if (!upi) { Alert.alert('Invalid', 'Enter UPI ID'); return; }
    try {
      setLoading(true);
      await apiFetch('/withdrawals', { method: 'POST', body: JSON.stringify({ amount: amt, upi_id: upi }) });
      Alert.alert('Requested', 'Withdrawal request sent to admin');
      setWithdrawAmount(''); setUpi('');
      await Promise.all([load(), refresh()]);
    } catch (e: any) { Alert.alert('Error', e.message); }
    finally { setLoading(false); }
  };

  const copyUpi = async () => {
    if (cfg?.upi_id) { await Clipboard.setStringAsync(cfg.upi_id); Alert.alert('Copied', 'UPI ID copied'); }
  };

  return (
    <View style={styles.root} testID="wallet-screen">
      <SafeAreaView edges={['top']} style={styles.header}>
        <Text style={styles.title}>WALLET</Text>
        <View style={styles.balanceBox}>
          <Text style={styles.balanceLabel}>COIN BALANCE</Text>
          <Text style={styles.balanceValue}>{user?.coins ?? 0}</Text>
          <View style={styles.balanceRow}>
            <View style={styles.mini}><Text style={styles.miniVal}>{user?.won_coins ?? 0}</Text><Text style={styles.miniLbl}>WON</Text></View>
            <View style={styles.mini}><Text style={styles.miniVal}>{user?.spent_coins ?? 0}</Text><Text style={styles.miniLbl}>SPENT</Text></View>
          </View>
        </View>
        <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: Spacing.sm }}>
          {(['add','withdraw','history'] as const).map(t => (
            <Pressable
              key={t}
              testID={`tab-${t}`}
              onPress={() => setTab(t)}
              style={[styles.tab, tab === t && styles.tabActive]}
            >
              <Text style={[styles.tabText, tab === t && styles.tabTextActive]}>
                {t === 'add' ? 'ADD COINS' : t === 'withdraw' ? 'WITHDRAW' : 'HISTORY'}
              </Text>
            </Pressable>
          ))}
        </ScrollView>
      </SafeAreaView>

      <ScrollView
        contentContainerStyle={styles.content}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={Colors.brand} />}
      >
        {tab === 'add' && (
          <>
            <Text style={styles.sectionLabel}>SELECT PACKAGE</Text>
            <View style={styles.pkgGrid}>
              {packages.map(p => {
                const active = selectedPkg?.id === p.id;
                return (
                  <Pressable
                    key={p.id}
                    testID={`pkg-${p.id}`}
                    onPress={() => setSelectedPkg(p)}
                    style={[styles.pkg, active && styles.pkgActive]}
                  >
                    <Text style={[styles.pkgCoins, active && { color: Colors.brand }]}>{p.coins}</Text>
                    <Text style={styles.pkgSub}>coins</Text>
                    <Text style={styles.pkgPrice}>₹{p.price}</Text>
                  </Pressable>
                );
              })}
            </View>

            {selectedPkg && (
              <View style={styles.qrCard}>
                <Text style={styles.sectionLabel}>PAY ₹{selectedPkg.price} VIA UPI</Text>
                <View style={styles.qrBox}>
                  <MaterialCommunityIcons name="qrcode" size={140} color={Colors.onSurface} />
                  <Text style={styles.qrHint}>Open any UPI app → Pay → enter UPI ID</Text>
                </View>
                <Pressable onPress={copyUpi} testID="copy-upi-btn" style={styles.upiRow}>
                  <Text style={styles.upiValue}>{cfg?.upi_id}</Text>
                  <MaterialCommunityIcons name="content-copy" size={16} color={Colors.brand} />
                </Pressable>

                <Text style={styles.sectionLabel}>UPLOAD PAYMENT SCREENSHOT</Text>
                <Pressable onPress={pickScreenshot} testID="pick-screenshot-btn" style={styles.uploadBox}>
                  {screenshot ? (
                    <Image source={{ uri: screenshot }} style={styles.uploadImg} />
                  ) : (
                    <>
                      <MaterialCommunityIcons name="camera-plus" size={32} color={Colors.brand} />
                      <Text style={styles.uploadText}>Tap to select screenshot</Text>
                    </>
                  )}
                </Pressable>

                <TextInput
                  testID="utr-input"
                  value={utr}
                  onChangeText={setUtr}
                  placeholder="UTR / Transaction ID (optional)"
                  placeholderTextColor={Colors.onSurfaceSecondary}
                  style={styles.input}
                />

                <Pressable
                  testID="submit-purchase-btn"
                  disabled={loading || !screenshot}
                  onPress={submitPurchase}
                  style={[styles.primaryBtn, (loading || !screenshot) && { opacity: 0.5 }]}
                >
                  {loading ? <ActivityIndicator color={Colors.surface} /> : <Text style={styles.primaryBtnText}>SUBMIT FOR VERIFICATION</Text>}
                </Pressable>
              </View>
            )}
          </>
        )}

        {tab === 'withdraw' && (
          <View style={styles.wdCard}>
            <Text style={styles.sectionLabel}>WITHDRAW COINS TO UPI</Text>
            <Text style={styles.helperText}>1 coin = ₹1. Admin will process manually.</Text>
            <TextInput
              testID="withdraw-amount"
              value={withdrawAmount}
              onChangeText={setWithdrawAmount}
              keyboardType="number-pad"
              placeholder="Amount"
              placeholderTextColor={Colors.onSurfaceSecondary}
              style={styles.input}
            />
            <TextInput
              testID="withdraw-upi"
              value={upi}
              onChangeText={setUpi}
              placeholder="Your UPI ID (e.g. name@ybl)"
              placeholderTextColor={Colors.onSurfaceSecondary}
              autoCapitalize="none"
              style={styles.input}
            />
            <Pressable testID="submit-withdraw-btn" onPress={submitWithdraw} disabled={loading} style={[styles.primaryBtn, loading && { opacity: 0.5 }]}>
              {loading ? <ActivityIndicator color={Colors.surface} /> : <Text style={styles.primaryBtnText}>REQUEST WITHDRAWAL</Text>}
            </Pressable>

            {wds.length > 0 && (
              <>
                <Text style={[styles.sectionLabel, { marginTop: Spacing.lg }]}>WITHDRAWAL REQUESTS</Text>
                {wds.map(w => (
                  <View key={w.withdrawal_id} style={styles.txnRow}>
                    <View style={{ flex: 1 }}>
                      <Text style={styles.txnTitle}>₹{w.amount} → {w.upi_id}</Text>
                      <Text style={styles.txnMeta}>{new Date(w.created_at).toLocaleString()}</Text>
                    </View>
                    <Text style={[styles.statusBadge, statusColor(w.status)]}>{w.status.toUpperCase()}</Text>
                  </View>
                ))}
              </>
            )}
          </View>
        )}

        {tab === 'history' && (
          <>
            <Text style={styles.sectionLabel}>PURCHASE HISTORY</Text>
            {purchases.length === 0 ? <Text style={styles.emptyText}>No purchases yet</Text> : purchases.map(p => (
              <View key={p.purchase_id} style={styles.txnRow}>
                <View style={{ flex: 1 }}>
                  <Text style={styles.txnTitle}>+{p.coins} coins (₹{p.amount})</Text>
                  <Text style={styles.txnMeta}>{new Date(p.created_at).toLocaleString()}</Text>
                </View>
                <Text style={[styles.statusBadge, statusColor(p.status)]}>{p.status.toUpperCase()}</Text>
              </View>
            ))}
            <Text style={[styles.sectionLabel, { marginTop: Spacing.lg }]}>ALL TRANSACTIONS</Text>
            {txns.length === 0 ? <Text style={styles.emptyText}>No transactions</Text> : txns.map(t => (
              <View key={t.txn_id} style={styles.txnRow}>
                <View style={{ flex: 1 }}>
                  <Text style={styles.txnTitle}>{typeLabel(t.type)} {t.amount > 0 ? '+' : ''}{t.amount}</Text>
                  <Text style={styles.txnMeta}>{new Date(t.created_at).toLocaleString()} · {t?.meta?.match_title || ''}</Text>
                </View>
                <Text style={[styles.statusBadge, statusColor(t.status)]}>{t.status.toUpperCase()}</Text>
              </View>
            ))}
          </>
        )}
      </ScrollView>
    </View>
  );
}

function typeLabel(t: string) {
  if (t === 'purchase') return '💰 Purchase';
  if (t === 'prize') return '🏆 Prize';
  if (t === 'match_entry') return '🎮 Entry';
  if (t === 'withdrawal') return '🏦 Withdrawal';
  return t;
}

function statusColor(s: string) {
  if (s === 'completed' || s === 'approved') return { color: Colors.success, borderColor: Colors.success };
  if (s === 'pending') return { color: Colors.warning, borderColor: Colors.warning };
  return { color: Colors.error, borderColor: Colors.error };
}

const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: Colors.surface },
  header: { padding: Spacing.lg, borderBottomWidth: 1, borderBottomColor: Colors.border, gap: Spacing.md },
  title: { color: Colors.onSurface, fontSize: 20, fontWeight: '800', letterSpacing: 2 },
  balanceBox: { backgroundColor: Colors.brandTertiary, borderRadius: Radius.lg, padding: Spacing.md, borderWidth: 1, borderColor: Colors.brand },
  balanceLabel: { color: Colors.onBrandTertiary, fontSize: 11, letterSpacing: 2, fontWeight: '700' },
  balanceValue: { color: Colors.onSurface, fontSize: 40, fontWeight: '900', letterSpacing: 1 },
  balanceRow: { flexDirection: 'row', gap: Spacing.lg, marginTop: Spacing.sm, borderTopWidth: 1, borderTopColor: 'rgba(255,255,255,0.15)', paddingTop: Spacing.sm },
