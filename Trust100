@api_router.post("/withdrawals")
async def create_withdrawal(payload: WithdrawalRequest, authorization: Optional[str] = Header(None))):
    user = await get_user_from_token(authorization)
    if payload.amount <= 0:
        raise HTTPException(400, "Invalid amount")
    if user["coins"] < payload.amount:
        raise HTTPException(400, "Insufficient coins")
    await db.users.update_one({"user_id": user["user_id"]}, {"$inc": {"coins": -payload.amount}})
    if not user.get("upi_id"):
        await db.users.update_one({"user_id": user["user_id"]}, {"$set": {"upi_id": payload.upi_id}})
    wd = {
        "withdrawal_id": uid("wd"),
        "user_id": user["user_id"],
        "user_name": user.get("name"),
        "user_email": user.get("email"),
        "user_phone": user.get("phone"),
        "amount": payload.amount,
        "upi_id": payload.upi_id,
        "status": "pending",
        "created_at": now_utc().isoformat(),
    }
    await db.withdrawals.insert_one(wd.copy())
    await db.transactions.insert_one({
        "txn_id": uid("txn"),
        "user_id": user["user_id"],
        "type": "withdrawal",
        "amount": -payload.amount,
        "status": "pending",
        "meta": {"withdrawal_id": wd["withdrawal_id"], "upi_id": payload.upi_id},
        "created_at": now_utc().isoformat(),
    })
    return {"success": True, "withdrawal_id": wd["withdrawal_id"]}

