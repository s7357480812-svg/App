        "user_phone": user.get("phone"),
        "package_id": pkg["id"],
        "coins": pkg["coins"],
        "amount": pkg["price"],
        "screenshot": payload.screenshot_base64,
        "utr": payload.utr,
        "status": "pending",
        "created_at": now_utc().isoformat(),
    }
    await db.purchases.insert_one(order.copy())
    await db.transactions.insert_one({
        "txn_id": uid("txn"),
        "user_id": user["user_id"],
        "type": "purchase",
        "amount": pkg["coins"],
        "status": "pending",
        "meta": {"purchase_id": order["purchase_id"], "amount_paid": pkg["price"]},
        "created_at": now_utc().isoformat(),
    })
    return {"success": True, "purchase_id": order["purchase_id"]}

