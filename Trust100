# ---------- Helpers ----------
def now_utc():
    return datetime.now(timezone.utc)

def uid(prefix: str = "u"):
    return f"{prefix}_{uuid.uuid4().hex[:12]}"

def clean(doc: Optional[dict]) -> Optional[dict]:
    if not doc:
        return doc
    doc.pop("_id", None)
    return doc

async def get_user_from_token(authorization: Optional[str]) -> dict:
    if not authorization or not authorization.startswith("Bearer "):
        raise HTTPException(status_code=401, detail="Missing token")
    token = authorization.split(" ", 1)[1].strip()
    session = await db.sessions.find_one({"session_token": token}, {"_id": 0})
    if not session:
        raise HTTPException(status_code=401, detail="Invalid session")
    expires_at = session.get("expires_at")
    if isinstance(expires_at, datetime):
        if expires_at.tzinfo is None:
            expires_at = expires_at.replace(tzinfo=timezone.utc)
        if expires_at < now_utc():
            raise HTTPException(status_code=401, detail="Session expired")
    user = await db.users.find_one({"user_id": session["user_id"]}, {"_id": 0})
    if not user:
        raise HTTPException(status_code=401, detail="User not found")
    return user

async def require_admin(authorization: Optional[str]) -> dict:
    user = await get_user_from_token(authorization)
    if not user.get("is_admin"):
        raise HTTPException(status_code=403, detail="Admin only")
    return user

async def ensure_user(email: Optional[str], name: Optional[str], picture: Optional[str], phone: Optional[str]) -> dict:
    query = {}
    if email:
        query["email"] = email
    elif phone:
        query["phone"] = phone
    user = await db.users.find_one(query, {"_id": 0}) if query else None
    is_admin = (email == ADMIN_EMAIL) or (phone == ADMIN_PHONE)
    if user:
        updates = {}
        if is_admin and not user.get("is_admin"):
            updates["is_admin"] = True
        if name and not user.get("name"):
            updates["name"] = name
        if picture and not user.get("picture"):
            updates["picture"] = picture
        if updates:
            await db.users.update_one({"user_id": user["user_id"]}, {"$set": updates})
            user.update(updates)
        return user
    new_user = {
        "user_id": uid("usr"),
        "email": email,
        "phone": phone,
        "name": name or (phone or (email.split("@")[0] if email else "Player")),
        "picture": picture,
        "coins": 0,
        "won_coins": 0,
        "spent_coins": 0,
        "is_admin": is_admin,
        "upi_id": None,
        "created_at": now_utc().isoformat(),
    }
    await db.users.insert_one(new_user.copy())
    return clean(new_user)

async def create_session(user_id: str) -> str:
    token = f"st_{uuid.uuid4().hex}"
    session = {
        "session_token": token,
        "user_id": user_id,
        "created_at": now_utc(),
        "expires_at": now_utc() + timedelta(days=7),
    }
    await db.sessions.insert_one(session)
    return token

