@api_router.post("/auth/session")
async def google_session(payload: GoogleSessionRequest):
    async with httpx.AsyncClient(timeout=30.0) as httpc:
        try:
            resp = await httpc.get(
                "https://demobackend.emergentagent.com/auth/v1/env/oauth/session-data",
                headers={"X-Session-ID": payload.session_id},
            )
        except Exception as e:
            raise HTTPException(401, f"Auth service error: {e}")
    if resp.status_code != 200:
        raise HTTPException(401, "Invalid session")
    data = resp.json()
    email = data.get("email")
    name = data.get("name")
    picture = data.get("picture")
    session_token_from_emergent = data.get("session_token")
    if not email:
        raise HTTPException(401, "No email in session")
    user = await ensure_user(email=email, name=name, picture=picture, phone=None)
    token = session_token_from_emergent or await create_session(user["user_id"])
    if session_token_from_emergent:
        await db.sessions.insert_one({
            "session_token": token,
            "user_id": user["user_id"],
            "created_at": now_utc(),
            "expires_at": now_utc() + timedelta(days=7),
        })
    return {"session_token": token, "user": user}

