@api_router.post("/admin/matches/{match_id}/kills")
async def admin_update_kills(match_id: str, payload: KillUpdate, authorization: Optional[str] = Header(None))):
    await require_admin(authorization)
    match = await db.matches.find_one({"match_id": match_id}, {"_id": 0})
    if not match:
        raise HTTPException(404, "Match not found")
    player = await db.match_players.find_one({"match_id": match_id, "user_id": payload.user_id}, {"_id": 0})
    if not player:
        raise HTTPException(404, "Player not in match")
    prev_prize = player.get("prize", 0)
    new_prize = payload.kills * match["per_kill_prize"]
    delta = new_prize - prev_prize
    await db.match_players.update_one(
        {"match_id": match_id, "user_id": payload.user_id},
        {"$set": {"kills": payload.kills, "prize": new_prize}},
    )
    if delta != 0:
        await db.users.update_one(
            {"user_id": payload.user_id},
            {"$inc": {"coins": delta, "won_coins": delta}},
        )
        await db.transactions.insert_one({
            "txn_id": uid("txn"),
            "user_id": payload.user_id,
            "type": "prize",
            "amount": delta,
            "status": "completed",
            "meta": {"match_id": match_id, "kills": payload.kills, "match_title": match["title"]},
            "created_at": now_utc().isoformat(),
        })
    return {"success": True, "prize": new_prize}

