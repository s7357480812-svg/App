@api_router.get("/matches/{match_id}")
async def get_match(match_id: str, authorization: Optional[str] = Header(None))):
    match = await db.matches.find_one({"match_id": match_id}, {"_id": 0})
    if not match:
        raise HTTPException(404, "Match not found")
    joined = False
    my_kills = 0
    if authorization:
        try:
            user = await get_user_from_token(authorization)
            entry = await db.match_players.find_one(
                {"match_id": match_id, "user_id": user["user_id"]}, {"_id": 0}
            )
            if entry:
                joined = True
                my_kills = entry.get("kills", 0)
        except HTTPException:
            pass
    match["joined"] = joined
    match["my_kills"] = my_kills
    if not joined:
        match.pop("room_id", None)
        match.pop("room_password", None)
    return match

@api_router.post("/matches/{match_id}/join")
async def join_match(match_id: str, payload: MatchJoinRequest, authorization: Optional[str] = Header(None))):
    user = await get_user_from_token(authorization)
    match = await db.matches.find_one({"match_id": match_id}, {"_id": 0})
    if not match:
        raise HTTPException(404, "Match not found")
    if match["status"] not in ("upcoming", "live"):
        raise HTTPException(400, "Match not open")
    if match.get("players_count", 0) >= match["max_players"]:
        raise HTTPException(400, "Match is full")
    existing = await db.match_players.find_one({"match_id": match_id, "user_id": user["user_id"]})
    if existing:
        raise HTTPException(400, "Already joined")
    if user["coins"] < match["entry_fee"]:
        raise HTTPException(400, "Insufficient coins")
    await db.users.update_one(
        {"user_id": user["user_id"]},
        {"$inc": {"coins": -match["entry_fee"], "spent_coins": match["entry_fee"]}},
    )
    entry = {
        "player_id": uid("mp"),
        "match_id": match_id,
        "user_id": user["user_id"],
        "user_name": user.get("name"),
        "game_name": payload.game_name,
        "kills": 0,
        "prize": 0,
        "joined_at": now_utc().isoformat(),
    }
    await db.match_players.insert_one(entry.copy())
    await db.matches.update_one({"match_id": match_id}, {"$inc": {"players_count": 1}})
    await db.transactions.insert_one({
        "txn_id": uid("txn"),
        "user_id": user["user_id"],
        "type": "match_entry",
        "amount": -match["entry_fee"],
        "status": "completed",
        "meta": {"match_id": match_id, "match_title": match["title"]},
        "created_at": now_utc().isoformat(),
    })
    return {"success": True}

