import { useCallback, useEffect, useState } from 'react';
import { View, Text, StyleSheet, ScrollView, Pressable, RefreshControl, ActivityIndicator } from 'react-native';
import { useRouter } from 'expo-router';
import { SafeAreaView } from 'react-native-safe-area-context';
import { MaterialCommunityIcons } from '@expo/vector-icons';
import { Colors, Spacing, Radius } from '@/src/theme';
import { apiFetch } from '@/src/api';

export default function MyMatches() {
  const [items, setItems] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const router = useRouter();

  const load = useCallback(async () => {
    try { setItems(await apiFetch('/my/matches')); } catch {}
  }, []);

  useEffect(() => { (async () => { await load(); setLoading(false); })(); }, [load]);

  const onRefresh = async () => { setRefreshing(true); await load(); setRefreshing(false); };

  return (
    <View style={styles.root} testID="my-matches-screen">
      <SafeAreaView edges={['top']} style={styles.header}>
        <Text style={styles.title}>MY MATCHES</Text>
      </SafeAreaView>
      {loading ? <ActivityIndicator color={Colors.brand} style={{ marginTop: 40 }} /> : (
        <ScrollView
          contentContainerStyle={styles.list}
          refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={Colors.brand} />}
        >
          {items.length === 0 ? (
            <View style={styles.empty}>
              <MaterialCommunityIcons name="trophy-broken" size={48} color={Colors.onSurfaceSecondary} />
              <Text style={styles.emptyText}>No joined matches yet</Text>
              <Pressable testID="explore-matches-btn" onPress={() => router.push('/(tabs)/home')} style={styles.exploreBtn}>
                <Text style={styles.exploreBtnText}>EXPLORE MATCHES</Text>
              </Pressable>
            </View>
          ) : items.map(entry => {
            const m = entry.match;
            return (
              <Pressable
                key={entry.player_id}
                testID={`my-match-${m.match_id}`}
                onPress={() => router.push(`/match/${m.match_id}`)}
                style={styles.card}
              >
                <View style={styles.rowBetween}>
                  <Text style={styles.matchTitle} numberOfLines={1}>{m.title}</Text>
                  <View style={[styles.pill, { backgroundColor: m.status === 'completed' ? Colors.surfaceTertiary : Colors.brandTertiary, borderColor: m.status === 'completed' ? Colors.border : Colors.brand }]}>
                    <Text style={[styles.pillText, { color: m.status === 'completed' ? Colors.onSurfaceSecondary : Colors.brand }]}>{m.status.toUpperCase()}</Text>
                  </View>
                </View>
                <Text style={styles.meta}>{m.game} • {m.mode} • Game name: {entry.game_name}</Text>
                <View style={styles.statsRow}>
                  <Stat label="KILLS" value={String(entry.kills)} />
                  <Stat label="PRIZE" value={`${entry.prize} 🪙`} highlight />
                  <Stat label="ENTRY" value={`${m.entry_fee} 🪙`} />
                </View>
                {m.room_id && (
                  <View style={styles.roomBox}>
                    <Text style={styles.roomLabel}>ROOM ID</Text>
                    <Text style={styles.roomVal}>{m.room_id}</Text>
                    <Text style={styles.roomLabel}>PASSWORD</Text>
                    <Text style={styles.roomVal}>{m.room_password}</Text>
                  </View>
                )}
              </Pressable>
            );
          })}
        </ScrollView>
      )}
    </View>
  );
}

function Stat({ label, value, highlight }: { label: string; value: string; highlight?: boolean }) {
  return (
    <View style={styles.stat}>
      <Text style={[styles.statVal, highlight && { color: Colors.success }]}>{value}</Text>
      <Text style={styles.statLbl}>{label}</Text>
    </View>
  );
}

const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: Colors.surface },
  header: { padding: Spacing.lg, borderBottomWidth: 1, borderBottomColor: Colors.border },
  title: { color: Colors.onSurface, fontSize: 20, fontWeight: '800', letterSpacing: 2 },
  list: { padding: Spacing.lg, gap: Spacing.md, paddingBottom: Spacing.xxxl },
  empty: { alignItems: 'center', padding: Spacing.xxl, gap: Spacing.md },
  emptyText: { color: Colors.onSurfaceSecondary },
  exploreBtn: { backgroundColor: Colors.brand, paddingHorizontal: Spacing.lg, paddingVertical: Spacing.md, borderRadius: Radius.md, marginTop: Spacing.md },
  exploreBtnText: { color: Colors.surface, fontWeight: '800', letterSpacing: 1 },
  card: { backgroundColor: Colors.surfaceSecondary, borderRadius: Radius.lg, padding: Spacing.md, borderWidth: 1, borderColor: Colors.border },
  rowBetween: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' },
  matchTitle: { color: Colors.onSurface, fontWeight: '700', fontSize: 15, flex: 1, marginRight: Spacing.sm },
  meta: { color: Colors.onSurfaceSecondary, fontSize: 12, marginTop: 4 },
  pill: { paddingHorizontal: Spacing.sm, paddingVertical: 3, borderRadius: Radius.pill, borderWidth: 1 },
  pillText: { fontSize: 10, fontWeight: '800' },
  statsRow: { flexDirection: 'row', gap: Spacing.md, marginTop: Spacing.md, borderTopWidth: 1, borderTopColor: Colors.divider, paddingTop: Spacing.md },
  stat: { flex: 1 },
  statVal: { color: Colors.onSurface, fontWeight: '800', fontSize: 16 },
  statLbl: { color: Colors.onSurfaceSecondary, fontSize: 10, letterSpacing: 1 },
  roomBox: { backgroundColor: Colors.brandTertiary, borderRadius: Radius.md, padding: Spacing.md, marginTop: Spacing.md, borderWidth: 1, borderColor: Colors.brand, gap: 2 },
  roomLabel: { color: Colors.onBrandTertiary, fontSize: 10, letterSpacing: 1, fontWeight: '700' },
  roomVal: { color: Colors.onSurface, fontWeight: '800', fontSize: 15 },
});
