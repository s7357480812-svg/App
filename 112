import { useEffect, useState, useCallback } from 'react';
import {
  View, Text, StyleSheet, ScrollView, Pressable, TextInput, ActivityIndicator, Alert, Modal
} from 'react-native';
import { useLocalSearchParams, useRouter } from 'expo-router';
import { SafeAreaView } from 'react-native-safe-area-context';
import { MaterialCommunityIcons } from '@expo/vector-icons';
import { Colors, Spacing, Radius } from '@/src/theme';
import { apiFetch } from '@/src/api';
import { useAuth } from '@/src/auth';

export default function MatchDetails() {
  const { id } = useLocalSearchParams<{ id: string }>();
  const router = useRouter();
  const { user, refresh } = useAuth();
  const [match, setMatch] = useState<any>(null);
  const [players, setPlayers] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [joinModalOpen, setJoinModalOpen] = useState(false);
  const [gameName, setGameName] = useState('');
  const [joining, setJoining] = useState(false);

  const load = useCallback(async () => {
    try {
      const m = await apiFetch(`/matches/${id}`);
      setMatch(m);
      const p = await apiFetch(`/matches/${id}/players`);
      setPlayers(p);
    } catch (e: any) { Alert.alert('Error', e.message); }
    finally { setLoading(false); }
  }, [id]);

  useEffect(() => { load(); }, [load]);

  const doJoin = async () => {
    if (!gameName.trim()) { Alert.alert('Missing', 'Enter your in-game name'); return; }
    try {
      setJoining(true);
      await apiFetch(`/matches/${id}/join`, {
        method: 'POST',
        body: JSON.stringify({ game_name: gameName.trim() }),
      });
      setJoinModalOpen(false); setGameName('');
      await Promise.all([load(), refresh()]);
      Alert.alert('Joined', 'You have joined this match!');
    } catch (e: any) { Alert.alert('Cannot join', e.message); }
    finally { setJoining(false); }
  };

  if (loading || !match) {
    return <View style={styles.center}><ActivityIndicator color={Colors.brand} /></View>;
  }

  const dt = new Date(match.start_time);
  const initials = match.game === 'BGMI' ? 'BG' : 'FF';

  return (
    <View style={styles.root} testID="match-details-screen">
      <SafeAreaView edges={['top']} style={styles.headerBar}>
        <Pressable testID="back-btn" onPress={() => router.back()} style={styles.iconBtn}>
          <MaterialCommunityIcons name="chevron-left" size={28} color={Colors.onSurface} />
        </Pressable>
        <Text style={styles.headerTitle}>MATCH DETAILS</Text>
        <View style={styles.iconBtn} />
      </SafeAreaView>

      <ScrollView contentContainerStyle={styles.content}>
        <View style={styles.hero}>
          <View style={styles.gameBadge}>
            <Text style={styles.gameBadgeText}>{initials}</Text>
          </View>
          <Text style={styles.title}>{match.title}</Text>
          <Text style={styles.subtitle}>{match.game} • {match.mode} • Max {match.max_players}</Text>
          <View style={[styles.statusPill, { backgroundColor: match.status === 'live' ? Colors.error : Colors.brandTertiary, borderColor: match.status === 'live' ? Colors.error : Colors.brand }]}>
            <Text style={styles.statusText}>{match.status.toUpperCase()}</Text>
          </View>
        </View>

        <View style={styles.statGrid}>
          <StatBox label="ENTRY" value={`${match.entry_fee} 🪙`} />
          <StatBox label="PER KILL" value={`₹${match.per_kill_prize}`} accent />
          <StatBox label="MAX KILL" value={`₹${match.per_kill_prize * 20}`} />
          <StatBox label="PLAYERS" value={`${match.players_count}/${match.max_players}`} />
          <StatBox label="TIME" value={dt.toLocaleString(undefined, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })} wide />
        </View>

        {match.joined && (
          <View style={styles.roomCard}>
            <Text style={styles.roomHeading}>YOU'RE IN THE MATCH</Text>
            {match.room_id ? (
              <>
                <View style={styles.roomRow}>
                  <Text style={styles.roomLabel}>ROOM ID</Text>
                  <Text style={styles.roomValue}>{match.room_id}</Text>
                </View>
                <View style={styles.roomRow}>
                  <Text style={styles.roomLabel}>PASSWORD</Text>
                  <Text style={styles.roomValue}>{match.room_password}</Text>
                </View>
              </>
            ) : (\
              <Text style={styles.roomHint}>Room ID & password will appear here before the match starts</Text>
            )}
            <View style={styles.roomRow}>
              <Text style={styles.roomLabel}>MY KILLS</Text>
              <Text style={styles.roomValue}>{match.my_kills}</Text>
            </View>
          </View>
        )}

        <Text style={styles.sectionLabel}>RULES</Text>
        <View style={styles.rulesBox}>
          <RuleItem text={`Entry fee: ${match.entry_fee} coins (auto-deducted)`} />
          <RuleItem text={`Earn ₹${match.per_kill_prize} coin equivalent per kill`} />
          <RuleItem text={`Maximum ${match.max_players} players`} />
          <RuleItem text="Room ID/Password shared 5 min before match" />
          <RuleItem text="No teaming / hacking. Violators banned." />
        </View>

        {players.length > 0 && (
          <>
            <Text style={styles.sectionLabel}>PLAYERS JOINED ({players.length})</Text>
            {players.map(p => (
              <View key={p.player_id} style={styles.playerRow}>
                <MaterialCommunityIcons name="account-circle" size={20} color={Colors.onSurfaceSecondary} />
                <Text style={styles.playerName}>{p.game_name}</Text>
                <Text style={styles.playerKills}>{p.kills} kills</Text>
              </View>
            ))}
          </>
        )}
      </ScrollView>

      {!match.joined && match.status !== 'completed' && (
        <SafeAreaView edges={['bottom']} style={styles.ctaBar}>
          <Pressable
            testID="join-match-btn"
            onPress={() => setJoinModalOpen(true)}
            style={styles.joinBtn}
          >
            <MaterialCommunityIcons name="crosshairs-gps" size={20} color={Colors.surface} />
            <Text style={styles.joinBtnText}>JOIN FOR {match.entry_fee} COINS</Text>
          </Pressable>
        </SafeAreaView>
      )}

      <Modal transparent visible={joinModalOpen} animationType="fade" onRequestClose={() => setJoinModalOpen(false)}>
        <View style={styles.modalOverlay}>
          <View style={styles.modalCard}>
            <Text style={styles.modalTitle}>Enter your Game Name</Text>
            <Text style={styles.modalHint}>This is the name that will appear in the game (BGMI/FF ID name)</Text>
            <TextInput
              testID="game-name-input"
              value={gameName}
              onChangeText={setGameName}
              placeholder="e.g. YourGamerTag"
              placeholderTextColor={Colors.onSurfaceSecondary}
              style={styles.modalInput}
            />
            <View style={{ flexDirection: 'row', gap: Spacing.sm }}>
              <Pressable onPress={() => setJoinModalOpen(false)} style={[styles.modalBtn, { backgroundColor: Colors.surfaceTertiary }]}>
                <Text style={{ color: Colors.onSurface, fontWeight: '700' }}>Cancel</Text>
              </Pressable>
              <Pressable testID="confirm-join-btn" onPress={doJoin} disabled={joining} style={[styles.modalBtn, { backgroundColor: Colors.brand, flex: 1 }]}>
                {joining ? <ActivityIndicator color={Colors.surface} /> : <Text style={{ color: Colors.surface, fontWeight: '800' }}>PAY & JOIN</Text>}
              </Pressable>
            </View>
          </View>
        </View>
      </Modal>
    </View>
  );
}

function StatBox({ label, value, accent, wide }: { label: string; value: string; accent?: boolean; wide?: boolean }) {
  return (
    <View style={[styles.statBox, wide && { width: '100%' }, accent && { borderColor: Colors.brand, backgroundColor: Colors.brandTertiary }]}>
      <Text style={[styles.statVal, accent && { color: Colors.brand }]}>{value}</Text>
      <Text style={styles.statLbl}>{label}</Text>
    </View>
  );
}

function RuleItem({ text }: { text: string }) {
  return (
    <View style={styles.ruleRow}>
      <MaterialCommunityIcons name="chevron-right" size={16} color={Colors.brand} />
      <Text style={styles.ruleText}>{text}</Text>
    </View>
  );
}

